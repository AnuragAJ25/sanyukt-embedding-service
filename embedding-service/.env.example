# Model configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Secret API Token for Authorization: Bearer <token>
# Generate a secure token using: openssl rand -hex 32
EMBEDDING_API_TOKEN=your_secure_api_token_here

# Batch limits and server settings
MAX_BATCH_SIZE=64
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Optional device override: 'cpu' or 'cuda' (defaults to auto-detection)
DEVICE=cpu

# Optional CORS allowed origins as comma-separated or JSON list. Leave empty for backend-to-backend.
ALLOWED_ORIGINS=[]
